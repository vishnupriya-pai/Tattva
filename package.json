{
  "name": "tattva",
  "version": "0.1.0",
  "private": true,
  "description": "Tattva — the immutable ledger of human cognitive labor (hackathon MVP monorepo)",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@tattva/web",
    "dev:api": "npm run dev --workspace=@tattva/api",
    "build": "npm run build --workspace=@tattva/api && npm run build --workspace=@tattva/web",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "prettier": "3.10.0",
    "typescript": "6.0.3"
  }
}
